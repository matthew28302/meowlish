/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database and logs
/data/
/logs/
*.db
*.db-wal
*.db-shm
*.db-journal

# backups cục bộ (audit M9 2026-10-08): chứa log build dev có fingerprint salt
# (AUTH_SALT) + snapshot SQLite chứa data user thật (bảng users, password hash)
# + .env.local副本 Filebase. KHÔNG track trong repo, giữ nguyên trên đĩa.
/backups/

# scratch & temp debug files
scratch/
*.py
*.html

# Art goc 2D pet (37MB PNG nguon, chi ton tai local): pipeline
# scripts/build-pet-art-2d.mjs da xuat ban WebP toi uu vao public/pet-art-2d/
# (phan duoc commit de deploy). Nguon giu nguyen tren may de build lai.
/art-2d-pet/

# Bo avatar pixel 99 linh vat (nguon ZIP 2.5MB chi ton tai local). Ban ho
# chinh deploy da duoc copy sang public/pixel-avatars/ (png/ + gif/) va thu
# muc do duoc commit; nguon giu nguyen tren de quy de lay lai asset.
/pixel_avatars_v2_100/
/click.png
/forgot.png
/home.png
/login.png
/meo.jpg
/meo.png
/mouse.png
/om.png
/register.png


.vercel

# Bí mật: chỉ chặn file env thực tế, KHÔNG chặn `.env.example` (file mẫu
# phải được commit để người khác biết cần đặt biến nào).
.env
.env.local
.env.*.local
!.env.example

# Artefact của Playwright (ảnh chụp lỗi, trace) — sinh ra mỗi lần chạy e2e
test-results/
playwright-report/
blob-report/

# Thu muc lam viec tam: preview email, ban so sanh GIF, artifact chan doan.
# Nguon Lottie da commit o scripts/assets/lottie/ nen temp/ khong can luu.
temp/
